---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ImageSlot from '../../components/case/ImageSlot.astro';
import Icon from '../../components/Icon.astro';
import { caseStudies } from '../../data/caseStudies.js';
import { selectedWorks } from '../../data/projects.js';

export function getStaticPaths() {
  return Object.keys(caseStudies).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const cs = caseStudies[slug];
const project = selectedWorks.find((p) => p.slug === slug);
const i = selectedWorks.findIndex((p) => p.slug === slug);
const next = selectedWorks[(i + 1) % selectedWorks.length];
const pad = (n) => String(n).padStart(2, '0');
let n = 0;
---
<Base title={`${cs.title} — Hanna Maksymuk`} description={cs.subtitle}>
  <Header />
  <main class="case" style={`--accent:${project?.bg || '#f7f7f7'};--accent-border:${project?.border || 'var(--color-line)'}`}>

    <!-- Intro: back link, title and subtitle -->
    <section class="intro">
      <a class="back" href="/#work">← Recent work</a>
      <h1>{cs.title.replace(/-/g, '\u2011')}</h1>   {/* keep hyphenated words together */}
      <p class="subtitle">{cs.subtitle}</p>
    </section>

    <!-- Meta strip: cells divided by thin lines -->
    <dl class="meta">
      {cs.meta.map((m) => (
        <div class="meta-cell">
          <dt>{m.label}</dt>
          <dd class={m.placeholder ? 'todo' : ''}>{m.value}</dd>
        </div>
      ))}
    </dl>

    <!-- Cover: the card colour with the product screenshot -->
    {cs.cover && (
      <div class="cover">
        <img src={cs.cover.src} alt={cs.cover.alt} />
      </div>
    )}

    <!-- Overview: heading on the left; Background, Problem and Outcome stacked on the right -->
    <section class="block overview">
      <div class="block-head"><h2>Overview</h2></div>
      <dl class="ov-list">
        {cs.overview && <div class="ov-item"><dt class="label">Background</dt><dd>{cs.overview}</dd></div>}
        {cs.problem && <div class="ov-item"><dt class="label">Problem</dt><dd>{cs.problem}</dd></div>}
        {cs.outcome && <div class="ov-item"><dt class="label">Outcome</dt><dd>{cs.outcome}</dd></div>}
      </dl>
    </section>

    <!-- Story -->
    {cs.blocks.map((b) => {
      n += 1;
      return (
        <section class={`block block-${b.type}`}>
          <div class="block-head">
            <p class="label">{pad(n)}</p>
            <h2>{b.title}</h2>
            {(b.type === 'metrics' || b.type === 'features') && b.intro && <p class="head-note">{b.intro}</p>}
          </div>
          <div class="block-body">
            {b.body?.map((p) => <p>{p}</p>)}
            {b.intro && b.type === 'section' && <p>{b.intro}</p>}
          </div>

          {b.type === 'section' && b.image && (
            <div class="block-wide"><ImageSlot image={b.image} /></div>
          )}

          {b.type === 'features' && (
            <>
              <ul class="features block-wide">
                {b.items.map((f, k) => (
                  <li>
                    {f.icon ? <span class="f-icon"><Icon name={f.icon} size="28" /></span> : <span class="label">{pad(k + 1)}</span>}
                    <h3>{f.title}</h3><p>{f.text}</p>
                  </li>
                ))}
              </ul>
              {b.images && (
                <div class="pair block-wide">{b.images.map((img) => <ImageSlot image={img} />)}</div>
              )}
            </>
          )}

          {b.type === 'metrics' && (
            <ul class="features metrics block-wide">
              {b.items.map((m) => (
                <li>
                  {m.value
                    ? <span class="value">{m.value}</span>
                    : <span class="f-icon"><Icon name={m.icon} size="28" /></span>}
                  <h3>{m.title}</h3><p>{m.text}</p>
                </li>
              ))}
            </ul>
          )}
        </section>
      );
    })}

    <!-- Next project -->
    {next && (
      <a class="next" href={`/work/${next.slug}`} style={`--next-bg:${next.bg}`}>
        <span class="label">Next project</span>
        <span class="next-title">{next.title} <span class="arrow" aria-hidden="true">→</span></span>
        <span class="next-sub">{next.summary}</span>
      </a>
    )}
  </main>
  <Footer />
</Base>

<style>
  /* Everything spans the framed area so row lines meet the side lines */
  .case > * { margin-inline: var(--line-x); }
  .label {
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8a8a8a;
  }

  /* Intro */
  .intro {
    padding: clamp(3rem, 2rem + 3vw, 5.5rem) var(--inset) clamp(3rem, 2rem + 2.5vw, 4.5rem);
  }
  .back { display: inline-block; margin-bottom: 2rem; font-size: 0.9375rem; color: #6b6b6b; text-decoration: none; }
  .back:hover { color: var(--color-text); }
  h1 { font-size: clamp(2.5rem, 1.5rem + 3.3vw, 4.5rem); font-weight: 500; line-height: 1.04; letter-spacing: -0.025em; }
  .subtitle { margin-top: 1.25rem; font-size: clamp(1.125rem, 1rem + 0.45vw, 1.5rem); line-height: 1.4; color: #5c5c5c; max-width: 32rem; }

  /* Meta strip */
  .meta {
    margin-block: 0;
    display: grid;
    grid-template-columns: repeat(var(--meta-cols, 3), minmax(0, 1fr));
    border-block: 1px solid var(--color-line);
  }
  .meta-cell { padding: 1.25rem var(--inset); }
  .meta-cell + .meta-cell { border-left: 1px solid var(--color-line); }
  dt { font-family: 'Geist Mono', ui-monospace, monospace; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: #8a8a8a; }
  dd { margin: 0.4rem 0 0; font-size: 1.0625rem; }
  dd.todo { color: #c0652f; }

  /* Cover */
  .cover {
    background: var(--accent);
    border-bottom: 1px solid var(--color-line);
    padding: clamp(2rem, 1rem + 4vw, 5rem) clamp(1.25rem, 0.5rem + 5vw, 6rem);
    overflow: hidden;
  }
  .cover img {
    display: block;
    width: 100%;
    max-width: 1200px;
    margin-inline: auto;
    border-radius: 10px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.05), 0 20px 50px -20px rgb(30 20 60 / 0.3);
  }

  /* Overview list: Background, Problem, Outcome separated by thin lines */
  .ov-list { margin: 0; }
  .ov-item + .ov-item { margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--color-line); }
  .ov-item dd { margin: 0.75rem 0 0; font-size: clamp(1.1875rem, 1rem + 0.5vw, 1.5rem); line-height: 1.5; letter-spacing: -0.005em; max-width: 42rem; }

  /* Story blocks: heading left, text right, wide media underneath */
  .block {
    display: grid;
    grid-template-columns: minmax(0, 0.76fr) minmax(0, 1fr);
    column-gap: clamp(2rem, 1rem + 2.5vw, 3.25rem);
    row-gap: 3rem;
    padding: clamp(3.5rem, 2rem + 3vw, 5.5rem) var(--inset);
    border-bottom: 1px solid var(--color-line);
  }
  .overview .block-head h2 { margin-top: 0; }
  .block-head h2 { margin-top: 0.75rem; font-size: clamp(1.5rem, 1rem + 1.1vw, 2.125rem); line-height: 1.2; letter-spacing: -0.015em; max-width: 26rem; }
  .block-body p { font-size: 1.125rem; line-height: 1.65; color: var(--color-muted); max-width: 40rem; }
  .block-body p + p { margin-top: 1.2em; }
  .block-wide { grid-column: 1 / -1; }

  /* Features: a lined grid of six */
  .features {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-line);
    border-left: 1px solid var(--color-line);
  }
  .features li { padding: 1.75rem 1.5rem 2rem; border-right: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }
  .f-icon { display: block; width: 28px; height: 28px; color: #9a9a9a; }
  .f-icon :global(svg) { display: block; stroke-width: 1.4; }
  .features h3 { margin-top: 1.25rem; font-size: 1.25rem; font-weight: 500; line-height: 1.3; }
  .features p { margin-top: 0.6rem; font-size: 1rem; line-height: 1.55; color: var(--color-muted); }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }

  /* Metrics */
  /* Metrics reuse the feature card grid; a figure can sit where the icon goes */
  .head-note { max-width: 32rem; margin-top: 1rem; font-size: 1.125rem; line-height: 1.55; color: var(--color-muted); }
  .metrics { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .value { display: block; height: 28px; font-size: 2rem; font-weight: 500; line-height: 28px; letter-spacing: -0.02em; color: #c0652f; }

  /* Next project */
  .next {
    display: grid;
    gap: 0.75rem;
    padding: clamp(3rem, 2rem + 3vw, 5rem) var(--inset);
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
    transition: background 0.3s ease;
  }
  .next:hover { background: var(--next-bg); }
  .next-title { font-size: clamp(1.75rem, 1.2rem + 1.8vw, 3rem); letter-spacing: -0.02em; line-height: 1.1; }
  .arrow { display: inline-block; transition: transform 0.3s ease; }
  .next:hover .arrow { transform: translateX(6px); }
  .next-sub { font-size: 1.0625rem; color: #6b6b6b; max-width: 40rem; }

  @media (max-width: 800px) {
    .block { grid-template-columns: 1fr; }
    .block { row-gap: 1.5rem; }
    .features, .metrics, .pair { grid-template-columns: 1fr; }
    .meta { grid-template-columns: 1fr; }
    .meta-cell + .meta-cell { border-left: 0; border-top: 1px solid var(--color-line); }
  }
  @media (min-width: 801px) and (max-width: 1100px) {
    .features { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
