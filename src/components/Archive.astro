---
const { items } = Astro.props;
---
<section class="archive" id="archive">
  <h2>Archive</h2>
  <ul>
    {items.map((item) => (
      <li class="row">
        <div class="text">
          <h3>{item.title}</h3>
          {item.body.map((para) => <p>{para}</p>)}
        </div>
        <div class="media">
          {item.cover?.type === 'shot' && (
            <img class="shot tonal-shadow" src={item.cover.src} alt={item.cover.alt} loading="lazy" decoding="async"
              style={`--x:${item.cover.x}%;--y:${item.cover.y}%;--w:${item.cover.w}%`} />
          )}
          {item.cover?.type === 'logo' && (
            <img class="logo tonal-shadow" src={item.cover.src} alt={item.cover.alt} loading="lazy" decoding="async"
              style={`--w:${item.cover.w}%`} />
          )}
        </div>
      </li>
    ))}
  </ul>
</section>

<style>
  /* Spans the framed area (side line to side line) so the row lines meet the page's side lines */
  .archive {
    margin-inline: var(--line-x);
    padding-top: clamp(4rem, 2rem + 5vw, 7.5rem);
    padding-bottom: clamp(4rem, 2rem + 6vw, 9rem);
  }
  h2 {
    font-size: var(--fs-h2);
    line-height: 1.1;
    padding-inline: var(--inset);
  }
  ul { list-style: none; margin: 0; padding: 0; }

  /* One project per row: text on the left, image on the right, a line under each row */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 0.76fr) minmax(0, 1fr);
    column-gap: clamp(2rem, 1rem + 2.5vw, 3.25rem);
    align-items: start;
    padding: 4.5rem var(--inset);
    border-bottom: 1px solid var(--color-line);
  }
  .row:first-child { padding-top: clamp(2.5rem, 1.5rem + 2vw, 3.25rem); }

  h3 {
    font-size: clamp(1.5rem, 1rem + 1.1vw, 2.125rem);   /* 34px on desktop */
    line-height: 1.2;
    white-space: pre-line;           /* keeps the designed line break in the title */
    margin-bottom: 1.375rem;
  }
  p { font-size: clamp(1rem, 0.95rem + 0.15vw, 1.0625rem); line-height: 1.6; color: var(--color-muted); }
  p + p { margin-top: 1.6em; }        /* one blank line between paragraphs */

  /* Light grey frame; the cover inside bleeds off its edges */
  .media {
    position: relative;
    aspect-ratio: 496 / 339;
    background: #f7f7f7;
    --surface: #f7f7f7;
    border: 1px solid var(--color-line);
    border-radius: 8px;
    overflow: hidden;
  }
  /* Screenshot entering from the left, cut off by the frame's right and bottom edges */
  .shot {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    max-width: none;
    height: auto;
    background: #fff;
    border-top-left-radius: 8px;
  }
  /* Logo on a small white card, centred */
  .logo {
    position: absolute;
    left: 50%;
    top: 50%;
    width: var(--w);
    height: auto;
    translate: -50% -50%;
    background: #fff;
    border-radius: 14px;
  }

  @media (max-width: 800px) {
    .row { grid-template-columns: 1fr; row-gap: 2rem; padding-block: 3rem; }
    h3 { white-space: normal; }
  }
</style>
