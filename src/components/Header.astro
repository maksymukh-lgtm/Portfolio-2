---
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#contacts', label: 'Contacts' },
];
---
<header class="site-header container">
  <a class="name" href="/">Hanna Maksymuk</a>
  <nav aria-label="Main">
    <ul>
      {links.map((l) => <li><a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>{l.label}</a></li>)}
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 2.25rem 0;
    font-size: 1.25rem; /* 20px */
    position: relative;
    z-index: 1;
  }
  a { text-decoration: none; }
  a:hover { text-decoration: underline; text-underline-offset: 4px; }
  ul { display: flex; gap: 2rem; list-style: none; margin: 0; padding: 0; }
  /* Name + 3 links don't fit at 20px on phones */
  @media (max-width: 560px) {
    .site-header { font-size: 1.0625rem; flex-wrap: wrap; row-gap: 0.75rem; }
    nav { width: 100%; }
    ul { gap: 1.25rem; }
  }
</style>
