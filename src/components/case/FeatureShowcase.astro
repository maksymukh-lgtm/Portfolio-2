---
/*
  Feature showcase card: flat coloured card with a short headline and
  subline, and product crops inside a soft double frame that fades out at the
  bottom. Optional floating icon tiles sit over the frame's top-right corner.
  Props (card): { bg, title, subtitle, icons: [names], shots: [{ src, alt, w? }] } (w = width in %)
*/
import Icon from '../Icon.astro';
const { card } = Astro.props;
---
<figure class={`showcase${card.full ? ' full' : ''}`} style={`--card:${card.bg};--fade:${card.fade || 62}%;--max:${card.maxH || 340}px;--stage-w:${card.stageW || 100}%`}>
  <p class="title">{card.title}</p>
  <p class="subtitle">{card.subtitle}</p>

  <div class="stage">
    <div class="frame">
      <div class="screen">
        {card.shots.map((s) => <img src={s.src} alt={s.alt} loading="lazy" decoding="async" style={s.w ? `width:${s.w}%` : ''} />)}
      </div>
    </div>
    {card.icons?.map((name, i) => (
      <span class="tile tonal-shadow" style={`--i:${i}`}><Icon name={name} size="28" /></span>
    ))}
  </div>
</figure>

<style>
  .showcase {
    --surface: var(--card);
    margin: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(1.25rem, 0.8rem + 1.2vw, 2rem);
    background: var(--card);
    border-radius: var(--radius-panel);
    overflow: hidden;
  }
  .title { margin-top: 0; font-size: clamp(1.25rem, 1rem + 0.7vw, 1.625rem); font-weight: 500; line-height: 1.25; letter-spacing: -0.01em; }
  .subtitle { margin-top: 0.4rem; font-size: 0.9375rem; line-height: 1.5; color: #5c5650; }

  .stage { width: var(--stage-w); margin-inline: auto; position: relative; margin-top: clamp(1.75rem, 1rem + 2vw, 3rem); padding: 0 4% 0; }
  /* Soft double frame: a translucent outer ring around a white screen */
  .frame {
    padding: 10px;
    border-radius: 28px;
    background: color-mix(in srgb, #fff 45%, transparent);
  }
  .screen {
    display: grid;
    gap: 14px;
    padding: clamp(1rem, 0.6rem + 1vw, 1.5rem);
    border-radius: 20px;
    background: #fff;
    max-height: var(--max);
    overflow: hidden;
    /* content fades out toward the bottom */
    -webkit-mask-image: linear-gradient(to bottom, #000 var(--fade), transparent);
            mask-image: linear-gradient(to bottom, #000 var(--fade), transparent);
  }
  .screen img { display: block; width: 100%; max-width: 100%; height: auto; border-radius: 8px; }

  /* Floating icon tiles over the frame's top-right corner */
  .tile {
    position: absolute;
    top: calc(-22px + var(--i) * 52px);
    right: calc(1% + var(--i) * 3%);
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 16px;
    background: #fff;
    color: #2a2420;
    rotate: calc(-4deg + var(--i) * 7deg);
  }
  .tile :global(svg) { stroke-width: 1.5; }

  /* `full`: show the whole interface, with no height cap or fade */
  @media (max-width: 700px) { .stage { width: 100%; } }
  .full .screen { max-height: none; -webkit-mask-image: none; mask-image: none; }
  @media (max-width: 700px) {
    .tile { width: 44px; height: 44px; border-radius: 12px; top: calc(-18px + var(--i) * 38px); }
    .tile :global(svg) { width: 22px; height: 22px; }
  }
</style>
