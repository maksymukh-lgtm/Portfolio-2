---
// A case study image. Until `src` is set it shows a labelled placeholder frame,
// so it's clear what image belongs there.
const { image } = Astro.props;
const ratio = image.ratio || '16 / 9';
---
<figure class={`slot${image.frame || image.layers ? ' framed' : ''}`} style={image.src && !image.ratio ? '' : `--ratio:${ratio}`}>
  {image.layers
    ? (
      <div class="panel comp" style={`--ratio:${ratio}`}>
        {image.layers.map((l) => (
          <div class="layer" style={`left:${l.x}%;top:${l.y}%;width:${l.w}%`}>
            <img class="tonal-shadow" src={l.src} alt={l.alt || ''} loading="lazy" decoding="async" />
            {l.marks?.map((m) => (
              <span class="mark" style={`left:${m.x}%;top:${m.y}%;width:${m.w}%;height:${m.h}%`}>
                {m.label && <span class={`pill pill-${m.side || 'top'}`}>{m.label}</span>}
              </span>
            ))}
            {l.label && <span class="pill pill-under">{l.label}</span>}
          </div>
        ))}
      </div>
    )
    : image.src
    ? (image.frame
        ? <div class="panel"><img class="tonal-shadow" src={image.src} alt={image.alt || ''} loading="lazy" decoding="async" /></div>
        : <img src={image.src} alt={image.alt || ''} loading="lazy" decoding="async" />)
    : (
      <div class="placeholder">
        <span class="tag">Image</span>
        <span class="what">{image.placeholder}</span>
      </div>
    )}
  {image.caption && <figcaption>{image.caption}</figcaption>}
</figure>

<style>
  .slot { margin: 0; }
  img, .placeholder {
    display: block;
    width: 100%;
    aspect-ratio: var(--ratio);
    border-radius: var(--radius-panel);
    border: 1px solid var(--color-line);
    object-fit: cover;
    background: #f7f7f7;
  }
  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    padding: 1.5rem;
    text-align: center;
    background:
      repeating-linear-gradient(135deg, transparent 0 14px, rgb(0 0 0 / 0.025) 14px 15px),
      #f7f7f7;
  }
  .tag {
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8a8a8a;
  }
  .what { max-width: 26rem; font-size: 0.9375rem; line-height: 1.5; color: #6b6b6b; }
  /* A real image presented on a panel in the project's colour */
  .framed .panel {
    padding: clamp(1rem, 0.5rem + 3vw, 3.5rem);
    background: var(--accent, #f7f7f7);
    --surface: var(--accent, #f7f7f7);
    border-radius: var(--radius-panel);
  }
  .framed img {
    aspect-ratio: auto;
    border: 0;
    border-radius: 8px;
  }
  /* Composition: several images layered on the panel, placed by % */
  .comp { position: relative; aspect-ratio: var(--ratio); overflow: hidden; }
  .comp .layer { position: absolute; }
  .comp .layer img { display: block; width: 100%; height: auto; }
  /* Phones: stack the layers so each snapshot stays readable */
  @media (max-width: 700px) {
    .comp { aspect-ratio: auto; display: grid; gap: 0.75rem; }
    .comp .layer { position: static; width: 100% !important; }
  }

  /* Highlights: an outlined area on a layer, with an optional label pill */
  .mark {
    position: absolute;
    border: 2px solid var(--highlight, #e46a1e);
    border-radius: 8px;
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--highlight, #e46a1e) 18%, transparent);
    pointer-events: none;
  }
  .pill {
    position: absolute;
    white-space: nowrap;
    padding: 0.3em 0.65em;
    border-radius: 999px;
    background: var(--highlight, #e46a1e);
    color: #fff;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: clamp(0.5625rem, 0.45rem + 0.3vw, 0.75rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.2;
  }
  .pill-top { left: -2px; bottom: calc(100% + 8px); }
  .pill-bottom { left: -2px; top: calc(100% + 8px); }
  .pill-bottom-right { right: -2px; top: calc(100% + 8px); }
  .pill-under { left: 0; top: calc(100% + 10px); background: color-mix(in srgb, var(--accent, #f7f7f7), #3a1a08 70%); }
  figcaption { margin-top: 0.75rem; font-size: 0.875rem; color: #6b6b6b; }
</style>
