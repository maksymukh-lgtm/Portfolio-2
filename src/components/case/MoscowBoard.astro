---
/*
  Prioritization board, rebuilt from the Figma board in HTML so it stays crisp:
  a blue board with a phase header, groups of sticky notes inside dashed
  outlines (purple = provider-facing, pink = MassAbility-facing), small label
  tabs naming each group, and red "Won't have" tags on deferred features.
  Props (board): { phase, legend?: true, groups: [{ name, audience, items: [{ text, wont? }] }], pinned?: { title, items } }
*/
const { board } = Astro.props;
---
<figure class="board">
  <div class="phase">{board.phase}</div>

  <div class="canvas">
    <div class="groups">
      {board.groups.map((g) => (
        <section class={`group ${g.audience === 'agency' ? 'agency' : 'provider'}`}>
          <span class="tab">{g.name}</span>
          <ul class="notes">
            {g.items.map((it) => (
              <li class={`note${it.wont ? ' wont' : ''}`}>
                {it.wont && <span class="pill">Won’t have</span>}
                <span class="text">{it.text}</span>
                <span class="sig">Hanna Maksymuk</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <aside class="side">
      {board.legend && (
        <div class="legend">
          <p class="l-title">Legend</p>
          <p><span class="dash provider"></span>Provider-facing</p>
          <p><span class="dash agency"></span>MassAbility-facing</p>
          <p><span class="pill">Won’t have</span>Not in this release</p>
        </div>
      )}
      {board.pinned && (
        <div class="pinned">
          <p class="p-title">{board.pinned.title}</p>
          <ul>{board.pinned.items.map((t) => <li>{t}</li>)}</ul>
        </div>
      )}
    </aside>
  </div>
</figure>

<style>
  .board {
    --blue: #c6e4fb;
    --provider: #8b5cf6;
    --agency: #e0559f;
    --surface: var(--blue);
    margin: 0;
    background: var(--blue);
    border-radius: var(--radius-panel);
    overflow: hidden;
    font-size: 12px;
  }
  /* White header bar inside the blue board, so the board's rounded corners show */
  .phase {
    margin: clamp(1rem, 0.6rem + 1.2vw, 1.5rem) clamp(1.25rem, 0.75rem + 2vw, 2.25rem) 0;
    padding: 0.8rem 1rem;
    background: #fff;
    border-radius: 6px;
    box-shadow: 0 1px 2px rgb(40 80 120 / 0.12);
    text-align: center;
    font-size: clamp(0.9375rem, 0.85rem + 0.3vw, 1.0625rem);
  }
  .canvas {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 210px;
    gap: 1.5rem;
    padding: clamp(1.5rem, 1rem + 1.5vw, 2rem) clamp(1.25rem, 0.75rem + 2vw, 2.25rem) clamp(1.25rem, 0.75rem + 2vw, 2.25rem);
  }
  .groups { display: flex; flex-wrap: wrap; gap: 2rem 1.5rem; align-items: flex-start; }
  .group { flex: 0 1 auto; }

  /* A group: dashed outline with a small label tab on its top edge */
  .group {
    position: relative;
    padding: 1.6rem 0.9rem 0.9rem;
    border: 1.5px dashed var(--line-c);
    border-radius: 3px;
  }
  .group.provider { --line-c: var(--provider); }
  .group.agency { --line-c: var(--agency); }
  .tab {
    position: absolute;
    top: -0.8rem;
    left: -0.6rem;
    padding: 0.3em 0.9em;
    background: #fff;
    border: 1.5px solid #1b1b1b;
    border-radius: 2px;
    font-size: 10.5px;
    white-space: nowrap;
  }

  /* Sticky notes */
  .notes { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .note {
    position: relative;
    flex: none;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 96px;
    min-height: 96px;
    padding: 0.6rem 0.6rem 0.45rem;
    background: #fff;
    border-radius: 2px;
    box-shadow: 0 1px 2px rgb(40 80 120 / 0.12), 0 6px 12px -8px rgb(40 80 120 / 0.35);
    font-size: 11.5px;
    line-height: 1.35;
    color: #1d1d1d;
  }
  .sig { margin-top: 0.6rem; font-size: 7px; color: #9aa3ab; }
  .note.wont { margin-top: 0.55rem; }
  .note.wont .text { color: #5c5c5c; }

  .pill {
    display: inline-block;
    padding: 0.2em 0.75em;
    background: #fbb9ae;
    border: 1.5px solid #e2574a;
    border-radius: 999px;
    color: #7a1f14;
    font-size: 9px;
    line-height: 1.2;
    white-space: nowrap;
  }
  .note .pill { position: absolute; top: -0.65rem; left: -0.35rem; }

  /* Side column: legend and the pinned list */
  .side { display: grid; gap: 1rem; align-content: start; }
  .legend, .pinned { background: #fff; border-radius: 3px; padding: 0.9rem; box-shadow: 0 1px 2px rgb(40 80 120 / 0.12); }
  .l-title, .p-title { font-weight: 500; margin-bottom: 0.6rem; }
  .legend p:not(.l-title) { display: flex; align-items: center; gap: 0.6em; margin-top: 0.45rem; color: #444; }
  .dash { width: 26px; border-top: 1.5px dashed; flex: none; }
  .dash.provider { color: var(--provider); }
  .dash.agency { color: var(--agency); }
  .p-title { margin: -0.9rem -0.9rem 0.7rem; padding: 0.55rem 0.9rem; background: #3aa0f0; color: #fff; text-align: center; border-radius: 3px 3px 0 0; }
  .pinned ul { margin: 0; padding-left: 1.1em; display: grid; gap: 0.2rem; color: #333; }

  @media (max-width: 900px) {
    .canvas { grid-template-columns: 1fr; }
    .side { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 560px) {
    .note { width: calc(50% - 0.3rem); min-height: 78px; font-size: 10.5px; }
    .group { width: 100%; }
    .sig { display: none; }
    .side { grid-template-columns: 1fr; }
    .groups { gap: 1.75rem 1rem; }
  }
</style>
