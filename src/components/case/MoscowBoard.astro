---
/*
  MoSCoW board, rebuilt as real HTML (crisp at any size, readable on phones).
  A summary row counts features per priority; below, the features that made the
  first release are grouped by workflow as solid cards, and the deferred ones
  are listed muted. Each group says who it's for (provider or MassAbility staff).
  Props (board): { title, note, columns: [{ priority, label, hint?, groups: [{ name, audience, items: [] }] }] }
*/
const { board } = Astro.props;
const PRIORITIES = [
  { key: 'must', label: 'Must have', color: '#3f8f6b' },
  { key: 'should', label: 'Should have', color: '#c9a227' },
  { key: 'could', label: 'Could have', color: '#5b8fc9' },
  { key: 'wont', label: "Won't have", color: '#c2553c' },
];
const count = (key) =>
  board.columns.filter((c) => c.priority === key).reduce((n, c) => n + c.groups.reduce((m, g) => m + g.items.length, 0), 0);
const colorOf = (key) => PRIORITIES.find((p) => p.key === key)?.color;
---
<figure class="moscow">
  <div class="head">
    <div>
      <p class="title">{board.title}</p>
      {board.note && <p class="note">{board.note}</p>}
    </div>
    <ul class="summary" aria-label="Features per priority">
      {PRIORITIES.map((p) => (
        <li class={count(p.key) ? '' : 'empty'}>
          <span class="dot" style={`background:${p.color}`}></span>
          <span class="s-label">{p.label}</span>
          <span class="s-count">{count(p.key)}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="cols">
    {board.columns.map((col) => (
      <section class={`col col-${col.priority}`} style={`--p:${colorOf(col.priority)}`}>
        <header class="col-head">
          <span class="dot"></span>
          <h4>{col.label}</h4>
          <span class="col-count">{col.groups.reduce((m, g) => m + g.items.length, 0)}</span>
          {col.hint && <p class="hint">{col.hint}</p>}
        </header>
        <div class="groups">
          {col.groups.map((g) => (
            <div class="group">
              <div class="g-head">
                <span class="g-name">{g.name}</span>
                <span class={`aud aud-${g.audience}`}>{g.audience === 'agency' ? 'MassAbility' : 'Provider'}</span>
              </div>
              <ul class="items">
                {g.items.map((it) => <li>{it}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>
</figure>

<style>
  .moscow {
    --surface: var(--accent, #f7f7f7);
    margin: 0;
    padding: clamp(1.25rem, 0.75rem + 2vw, 2.5rem);
    background: var(--accent, #f7f7f7);
    border-radius: var(--radius-panel);
  }
  .head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1.25rem 2rem; margin-bottom: 1.75rem; }
  .title { font-size: clamp(1.125rem, 1rem + 0.5vw, 1.375rem); font-weight: 500; letter-spacing: -0.01em; }
  .note { margin-top: 0.35rem; font-size: 0.875rem; line-height: 1.5; color: #4f5a57; max-width: 34rem; }

  .summary { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .summary li {
    display: inline-flex; align-items: center; gap: 0.5em;
    padding: 0.45em 0.75em;
    background: #fff; border-radius: 999px;
    font-size: 0.8125rem;
  }
  .summary li.empty { background: color-mix(in srgb, #fff 50%, transparent); color: #7a8582; }
  .s-count { font-family: 'Geist Mono', ui-monospace, monospace; font-weight: 500; }
  .dot { width: 8px; height: 8px; border-radius: 50%; flex: none; background: var(--p); }

  .cols { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 1rem; align-items: start; }
  .col { background: color-mix(in srgb, #fff 55%, transparent); border-radius: 10px; padding: 1rem; }
  .col-head { display: flex; align-items: center; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.9rem; }
  .col-head h4 { margin: 0; font-size: 1rem; font-weight: 500; }
  .col-count { font-family: 'Geist Mono', ui-monospace, monospace; font-size: 0.8125rem; color: #6b6b6b; }
  .hint { flex-basis: 100%; font-size: 0.8125rem; line-height: 1.45; color: #5d6664; }

  .groups { display: grid; gap: 0.75rem; }
  .group { background: #fff; border-radius: 8px; padding: 0.85rem; }
  .g-head { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; margin-bottom: 0.65rem; }
  .g-name { font-size: 0.875rem; font-weight: 500; }
  .aud {
    flex: none;
    padding: 0.15em 0.55em;
    border-radius: 4px;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: 0.6875rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .aud-provider { background: #ece7fb; color: #5a45a8; }
  .aud-agency { background: #fbe7f1; color: #a33a73; }

  .items { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .items li {
    padding: 0.4em 0.6em;
    border-radius: 6px;
    font-size: 0.8125rem;
    line-height: 1.3;
  }
  /* In the release: solid, tinted with the priority colour */
  .col-must .items li { background: color-mix(in srgb, var(--p) 12%, #fff); border: 1px solid color-mix(in srgb, var(--p) 30%, #fff); color: #1f3a2e; }
  /* Deferred: quiet, dashed */
  .col-wont .group { background: color-mix(in srgb, #fff 80%, transparent); }
  .col-wont .items li { border: 1px dashed #c9cfcd; color: #6f7775; }

  @media (max-width: 800px) {
    .cols { grid-template-columns: 1fr; }
    .group { padding: 0.7rem; }
    .items li { font-size: 0.75rem; }
    /* Deferred features read as a compact list on phones */
    .col-wont .items { gap: 0; }
    .col-wont .items li { border: 0; padding: 0; color: #6f7775; }
    .col-wont .items li:not(:last-child)::after { content: '·'; margin: 0 0.45em; color: #b5bbb9; }
  }
</style>
