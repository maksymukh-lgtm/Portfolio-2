---
/*
  Process overview: a horizontal timeline of stages with a short bullet list
  under each and an "ongoing" track underneath. Pixel details tie it to the hero
  animation: the line is a run of square pixels that warms from teal to
  tangerine, each stage node is a small pixel ring in that stage's colour, the
  arrowheads are stepped pixels, and a few loose pixels scatter off the end like
  the hero's dissolving edge. Becomes a vertical timeline on phones.
  Props (process): { title, stages: [{ label, points: [] }], ongoing? }
*/
const { process } = Astro.props;
// Stage colours warm along the timeline, like pixels falling into the hero's core
const RAMP = ['#4f8f8a', '#8fc3bd', '#e2c048', '#f98f33', '#e46a1e'];
const colourAt = (i, n) => RAMP[Math.round((i / Math.max(1, n - 1)) * (RAMP.length - 2))];
// Pixel ring: 4x4 cells, outer ring filled
const ring = [];
for (let y = 0; y < 4; y++) for (let x = 0; x < 4; x++) if (x === 0 || y === 0 || x === 3 || y === 3) ring.push([x, y]);
// Loose pixels drifting off the end of the timeline (x, y in px from the arrow, size, colour index)
const scatter = [[-10, -14, 4, 3], [-24, -26, 3, 4], [-6, -32, 3, 2], [-38, -18, 4, 3], [-18, -44, 3, 4], [-52, -34, 2, 2], [-30, -52, 3, 3], [-8, -58, 2, 4]];
---
<figure class="process" style={`--n:${process.stages.length}`}>
  <p class="title">{process.title}</p>

  <div class="track-wrap">
    <span class="pix-line" aria-hidden="true"></span>
    <svg class="pix-arrow" viewBox="0 0 3 5" aria-hidden="true" shape-rendering="crispEdges"><rect x="0" y="0" width="1" height="1" /><rect x="1" y="1" width="1" height="1" /><rect x="2" y="2" width="1" height="1" /><rect x="1" y="3" width="1" height="1" /><rect x="0" y="4" width="1" height="1" /></svg>
    <span class="scatter" aria-hidden="true">
      {scatter.map(([x, y, s, c]) => <i style={`left:${x}px;top:${y}px;width:${s}px;height:${s}px;background:${RAMP[c]}`}></i>)}
    </span>

    <ol class="stages">
      {process.stages.map((s, i) => (
        <li class="stage" style={`--c:${colourAt(i, process.stages.length)}`}>
          <span class="label">{s.label}</span>
          <svg class="node" viewBox="0 0 4 4" aria-hidden="true" shape-rendering="crispEdges">
            {ring.map(([x, y]) => <rect x={x} y={y} width="0.86" height="0.86" />)}
          </svg>
          <ul class="points">{s.points.map((p) => <li>{p}</li>)}</ul>
        </li>
      ))}
    </ol>
  </div>

  {process.ongoing && (
    <div class="ongoing">
      <span class="o-text">{process.ongoing}</span>
      <span class="o-line" aria-hidden="true"><svg class="o-arrow" viewBox="0 0 3 5" shape-rendering="crispEdges"><rect x="0" y="0" width="1" height="1" /><rect x="1" y="1" width="1" height="1" /><rect x="2" y="2" width="1" height="1" /><rect x="1" y="3" width="1" height="1" /><rect x="0" y="4" width="1" height="1" /></svg></span>
    </div>
  )}
</figure>

<style>
  .process {
    --ink: #1d1d1d;
    overflow: hidden;
    --ramp: linear-gradient(90deg, #4f8f8a, #8fc3bd 30%, #e2c048 62%, #f98f33 88%, #e46a1e);
    margin: 0;
    padding: clamp(2rem, 1.25rem + 3vw, 4rem) clamp(1.5rem, 0.5rem + 6vw, 7rem);
    background: var(--accent, #f2f3f6);
    border-radius: var(--radius-panel);
    color: var(--ink);
  }
  .title {
    text-align: center;
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.5rem);
    font-weight: 500;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3.25rem);
  }

  .track-wrap { position: relative; --row: calc(1.6em + 1rem); }
  .track-wrap { font-size: clamp(0.8125rem, 0.7rem + 0.35vw, 1rem); }

  /* The timeline: a run of square pixels warming from teal to tangerine */
  .pix-line {
    position: absolute;
    left: 9px;
    right: 8px;
    top: calc(var(--row) + 7px);
    height: 4px;
    background: var(--ramp);
    -webkit-mask: repeating-linear-gradient(90deg, #000 0 4px, transparent 4px 7px);
            mask: repeating-linear-gradient(90deg, #000 0 4px, transparent 4px 7px);
  }
  .pix-arrow { position: absolute; right: 0; top: calc(var(--row) + 4px); width: 6px; height: 10px; fill: #e46a1e; }
  .scatter { position: absolute; right: 0; top: calc(var(--row) + 9px); width: 0; height: 0; }
  .scatter i { position: absolute; display: block; opacity: 0.85; }

  .stages {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    column-gap: 1.5rem;
  }
  .label {
    display: block;
    height: 1.6em;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  /* Stage node: a small pixel ring in the stage's colour */
  .node {
    position: relative;
    z-index: 1;
    display: block;
    width: 18px;
    height: 18px;
    margin: 1rem 0 1.25rem;
    fill: var(--c);
    background: var(--accent, #f2f3f6);
    box-shadow: 0 0 0 4px var(--accent, #f2f3f6);
  }
  .points { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; font-size: clamp(0.875rem, 0.8rem + 0.25vw, 1.0625rem); line-height: 1.4; }
  /* Square pixel bullets in the stage colour */
  .points li { position: relative; padding-left: 1.05em; }
  .points li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 5px; height: 5px; background: var(--c); }

  /* Ongoing track: a dotted row of pixels with a stepped arrow */
  .ongoing { margin-top: clamp(2rem, 1.5rem + 2vw, 3rem); font-size: clamp(0.8125rem, 0.7rem + 0.35vw, 1rem); }
  .o-text { display: block; margin-bottom: 0.65rem; letter-spacing: 0.02em; text-transform: uppercase; }
  .o-line {
    position: relative;
    display: block;
    height: 3px;
    margin-right: 10px;
    background: repeating-linear-gradient(90deg, var(--ink) 0 3px, transparent 3px 7px);
  }
  .o-arrow { position: absolute; right: -9px; top: -3.5px; width: 6px; height: 10px; fill: var(--ink); }

  /* Phones: a vertical timeline */
  @media (max-width: 700px) {
    .stages { grid-template-columns: 1fr; row-gap: 1.5rem; padding-left: 2rem; }
    .pix-line {
      left: 7px; right: auto; top: 6px; bottom: 10px; width: 4px; height: auto;
      background: linear-gradient(180deg, #4f8f8a, #8fc3bd 30%, #e2c048 62%, #f98f33 88%, #e46a1e);
      -webkit-mask: repeating-linear-gradient(180deg, #000 0 4px, transparent 4px 7px);
              mask: repeating-linear-gradient(180deg, #000 0 4px, transparent 4px 7px);
    }
    .pix-arrow { right: auto; left: 6px; top: auto; bottom: 2px; rotate: 90deg; }
    .scatter { display: none; }
    .stage { position: relative; }
    .node { position: absolute; left: -2rem; top: 0.1em; margin: 0; }
    .label { margin-bottom: 0.5rem; height: auto; white-space: normal; }
  }
</style>
