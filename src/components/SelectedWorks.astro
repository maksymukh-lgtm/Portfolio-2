---
import WorkCard from './WorkCard.astro';
const { works } = Astro.props;
---
<section id="work" class="works">
  <div class="works-head">
    <h2>Recent Work</h2>
  </div>
  <ul class="works-grid">
    {works.map((w) => <li class="cell"><WorkCard {...w} href={`/work/${w.slug}`} /></li>)}
  </ul>
</section>

<style>
  /* The section spans the full framed area (side line to side line) so its
     horizontal lines meet the page's side lines. It sits above the hero canvas,
     which bleeds into its top spacing. */
  .works {
    position: relative;
    z-index: 1;
    margin-inline: var(--line-x);
    padding-top: clamp(7rem, 3rem + 10vw, 14rem);  /* space above: ~112px phones → 184px @1440 → 224px wide screens */
  }
  .works-head {
    padding: 0 var(--inset) 3rem;
    border-bottom: 1px solid var(--color-line);
  }
  h2 { font-size: var(--fs-h2); line-height: 1.1; }

  /* Two columns of cells divided by 1px lines */
  .works-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .cell {
    padding: 1.125rem;            /* 18px between the lines and the card */
    border-bottom: 1px solid var(--color-line);
  }
  .cell:nth-child(odd) { border-right: 1px solid var(--color-line); }

  @media (max-width: 700px) {
    .works-grid { grid-template-columns: 1fr; }
    .cell:nth-child(odd) { border-right: 0; }
    .cell { padding: 0.75rem; }
  }
</style>
