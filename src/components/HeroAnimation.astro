---
/*
  Hero pixel field: "black hole".
  Pixels spawn along every edge and spiral into a dark core in the middle of
  the hero, leaving short streaks and heating up in colour as they speed up.
  The core grows with every pixel it swallows; once it is full it explodes,
  spraying pixels back out with a shockwave ring. The debris cools and fades,
  and the cycle starts again.

  Everything is drawn snapped to a grid of square cells, coloured by a 0..1
  value mapped to a colour band (see BANDS). Pure canvas 2D, no libraries.
  Pauses off-screen; reduced-motion visitors get one still frame.
*/
---

<div class="hero-anim" aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .hero-anim {
    /* The canvas runs past the hero into the next section's top spacing,
       so the pixels dissolve into it instead of stopping at a box edge. */
    --bleed: clamp(64px, 8vw, 112px);
    position: relative;
    z-index: 0;
    height: calc(clamp(220px, 30vw, 430px) + var(--bleed));
    margin-bottom: calc(-1 * var(--bleed));
    background: var(--color-bg);
    border-top: 1px solid var(--color-line);
    cursor: crosshair;
    touch-action: pan-y;
    overflow: hidden;
  }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
</style>

<script>
  // Palette inspired by a soft, grainy sunrise gradient: misty teal and peach on
  // the outside, warming through sunshine and marigold to tangerine as pixels
  // fall toward the core (like heading into the sun). The core is ink black.
  // `w` = how often a colour is picked for incoming pixels, `b` = for the explosion.
  const PALETTE = [
    { c: '#f98f33', w: 0.6, b: 2.6 },  // 0 tangerine
    { c: '#fcbc45', w: 1.6, b: 2.4 },  // 1 marigold
    { c: '#fde27a', w: 1.8, b: 1.8 },  // 2 sunshine
    { c: '#f8cfa6', w: 1.6, b: 1.4 },  // 3 peach
    { c: '#8fc3bd', w: 2.4, b: 0.8 },  // 4 seafoam teal
    { c: '#c3ddd5', w: 1.6, b: 0.4 },  // 5 misty aqua
    { c: '#e46a1e', w: 0.3, b: 1.2 },  // 6 burnt orange
    { c: '#4f8f8a', w: 0.6, b: 0.2 },  // 7 deep teal
  ];
  const CORE = '#161412';      // ink black, like the wordmark
  const LEAVES = [0, 1, 6, 0]; // what pixels warm into as they fall close to the core
  const DEEPEST = 6;           // last stretch before the core: burnt orange
  const WARM = [0, 1, 6];      // the core's flickering rim and the shockwave
  const HALO = '249,143,51';   // soft glow around the core (free styles), as r,g,b
  const ALPHAS = [1, 0.6, 0.3]; // streak head → tail
  const DEPTH = 190;           // px from the core where pixels start warming up

  // Drawing style.
  //   Grid styles:  'square' | 'tight' | 'round' | 'dot' | 'petal' | 'brush'
  //   Free styles (no grid): 'threads' | 'glow' | 'blossom' | 'watercolor'
  // (?pixel=… in the URL overrides it, for comparing styles)
  const params = new URLSearchParams(location.search);
  const SHAPE = params.get('pixel') || 'square';
  const FREE = ['threads', 'glow', 'blossom', 'watercolor'].includes(SHAPE);
  const TRAIL_LEN_BASE = ({ threads: 16, glow: 7, blossom: 1, watercolor: 7 } as Record<string, number>)[SHAPE] ?? 8;
  const CELL = Number(params.get('cell')) || 0;   // optional cell size override

  // Tuning
  const CAPACITY = 480;        // average pixels swallowed before the core explodes (varies ±25% per cycle)
  const MAX_INFALL = 10;       // …or after roughly this many seconds, whichever comes first
  const COOLDOWN = 1.6;        // seconds after an explosion when the edges only trickle
  const MAX_PIXELS = 2400;     // upper bound on live pixels (keeps it smooth on slower machines)
  const TRAIL_FADE = 0.004;    // streak decay per second (lower = shorter streaks)
  const SPEED = Number(params.get('speed')) || 0.55;  // overall pace: 1 = original, lower = slower
  // Trails keep the same length on screen at any speed
  const TRAIL_LEN = Math.max(1, Math.round(TRAIL_LEN_BASE / SPEED));

  const hash3 = (x: number, y: number, z: number) => {
    let h = (x * 374761393 + y * 668265263 + z * 2147483647) | 0;
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
  };
  const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
  const rand = (a: number, b: number) => a + Math.random() * (b - a);

  type P = { x: number; y: number; vx: number; vy: number; out: boolean; life: number; max: number; col: number; age: number; lx?: number; ly?: number; sz?: number; spin?: number; hist?: number[] };

  function pickColour(burst = false) {
    const wt = (p: (typeof PALETTE)[number]) => (burst ? p.b : p.w);
    let u = Math.random() * PALETTE.reduce((a, p) => a + wt(p), 0);
    for (let k = 0; k < PALETTE.length; k++) { u -= wt(PALETTE[k]); if (u <= 0) return k; }
    return 0;
  }

  function init(root: HTMLElement) {
    const cv = root.querySelector('canvas')!;
    const ctx = cv.getContext('2d');
    if (!ctx) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const touch = !matchMedia('(hover: hover) and (pointer: fine)').matches;

    let W = 0, H = 0, cell = 10, cols = 0, rows = 0, cx = 0, cy = 0, scale = 1;
    let heat = new Float32Array(0);   // streak intensity per cell
    let col = new Int8Array(0);       // colour index per cell
    let key = new Int16Array(0);      // colour × alpha bucket to draw, -1 = empty
    let ang = new Float32Array(0);    // direction of travel per cell (for petal shapes)

    function size() {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      W = root.clientWidth; H = root.clientHeight;
      cell = CELL || (W < 600 ? 7 : 10);
      cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(W / cell); rows = Math.ceil(H / cell);
      heat = new Float32Array(cols * rows);
      col = new Int8Array(cols * rows);
      key = new Int16Array(cols * rows);
      ang = new Float32Array(cols * rows);
      const bleed = parseFloat(getComputedStyle(root).getPropertyValue('--bleed')) || 0;
      cx = W / 2; cy = (H - bleed) / 2;   // centre of the visible hero area
      scale = Math.min(1, W / 1440 + 0.25);
    }

    // ---------- simulation ----------
    const ps: P[] = [];
    let phase: 'infall' | 'cooldown' = 'infall';
    let phaseT = 0, mass = 0, R = 0, spawnAcc = 0;
    // Each cycle gets a slightly different size and length so the rhythm never feels mechanical
    let capacity = CAPACITY, maxInfall = MAX_INFALL;
    const newCycle = () => { capacity = CAPACITY * rand(0.75, 1.25); maxInfall = MAX_INFALL * rand(0.8, 1.2); };
    newCycle();
    const waves: { t0: number; pow: number }[] = [];
    let simT = 0;

    const coreRadius = () => (cell * 1.2 + Math.sqrt(mass) * 1.7) * scale;

    function spawn() {
      // Pick an edge weighted by its length
      const per = 2 * (W + H), u = Math.random() * per;
      let x: number, y: number;
      if (u < W) { x = u; y = -2; }
      else if (u < 2 * W) { x = u - W; y = H + 2; }
      else if (u < 2 * W + H) { x = -2; y = u - 2 * W; }
      else { x = W + 2; y = u - 2 * W - H; }
      const dx = cx - x, dy = cy - y, d = Math.hypot(dx, dy) || 1;
      const nx = dx / d, ny = dy / d;
      // Mostly sideways velocity (counter-clockwise) so they spiral rather than fall straight
      const tang = rand(105, 175) * scale, rad = rand(45, 90) * scale;
      ps.push({ x, y, vx: -ny * tang + nx * rad, vy: nx * tang + ny * rad, out: false, life: 0, max: 0, col: pickColour(), age: 0 });
    }

    function explode(power = 1) {
      const n = Math.min(900, Math.max(120, Math.round(mass * 1.05 * power)));
      const r0 = Math.max(R, cell);
      for (let k = 0; k < n; k++) {
        const a = Math.random() * Math.PI * 2;
        const sp = (420 + 1100 * Math.pow(Math.random(), 1.3)) * scale * (0.7 + 0.3 * power);
        const life = rand(1.1, 2.8);
        const rr = r0 * (0.75 + 0.25 * Math.random());
        ps.push({ x: cx + Math.cos(a) * rr, y: cy + Math.sin(a) * rr,
          vx: Math.cos(a) * sp, vy: Math.sin(a) * sp, out: true, life, max: life, col: pickColour(true), age: 0 });
      }
      // Any pixel still falling in gets flung outwards too
      for (const p of ps) if (!p.out) {
        const dx = p.x - cx, dy = p.y - cy, d = Math.hypot(dx, dy) || 1;
        const kick = (900 * scale) / Math.sqrt(d / 40 + 1);
        p.vx += (dx / d) * kick; p.vy += (dy / d) * kick; p.out = true; p.life = p.max = rand(1, 2.2);
      }
      waves.push({ t0: simT, pow: 0.8 + 0.5 * power });
      mass = 0; phase = 'cooldown'; phaseT = 0; newCycle();
    }

    // ---------- interaction ----------
    let px = -9999, py = -9999, inside = false, charging = false, chargeStart = 0;
    const local = (e: PointerEvent) => { const r = cv.getBoundingClientRect(); return [e.clientX - r.left, e.clientY - r.top]; };
    const within = (x: number, y: number) => x >= 0 && y >= 0 && x <= W && y <= H;
    addEventListener('pointermove', (e) => { [px, py] = local(e); inside = within(px, py); if (!inside) charging = false; }, { passive: true });
    document.addEventListener('pointerleave', () => { inside = false; charging = false; });
    addEventListener('pointerdown', (e) => {
      const [x, y] = local(e);
      if (!within(x, y) || (e.target as Element).closest('a, button, input, textarea, select')) return;
      if (touch) { if (phase === 'infall' && mass > 20) explode(0.9); return; }
      charging = true; chargeStart = performance.now() / 1000;
    });
    addEventListener('pointerup', () => {
      if (!charging) return;
      charging = false;
      const charge = Math.min((performance.now() / 1000 - chargeStart) / 1.5, 1);
      if (phase === 'infall' && mass > 20) explode(0.6 + charge * 0.7);   // detonate early
    });

    function step(dt: number) {
      simT += dt; phaseT += dt;

      // The edges never stop: a gentle trickle right after an explosion, easing back up to full flow
      const rate = phase === 'infall'
        ? 30 + Math.min(phaseT, 6) * 22
        : 12 + 18 * (phaseT / COOLDOWN);
      spawnAcc += rate * dt * (W / 1440 + 0.35);
      while (spawnAcc >= 1) { if (ps.length < MAX_PIXELS) spawn(); spawnAcc--; }
      if (phase === 'infall') {
        if (mass >= capacity || phaseT > maxInfall) explode(1);
      } else if (phaseT > COOLDOWN) { phase = 'infall'; phaseT = 0; }

      // Core radius eases toward its target. Near capacity it starts to pulse (the build-up);
      // after an explosion it shrinks away smoothly instead of vanishing.
      const fill = phase === 'infall' ? Math.max(mass / capacity, phaseT / maxInfall) : 0;
      const pulse = fill > 0.8 ? 1 + 0.1 * ((fill - 0.8) / 0.2) * Math.sin(simT * (14 + 16 * fill)) : 1;
      const target = phase === 'infall' ? coreRadius() * pulse : 0;
      R += (target - R) * Math.min(1, dt * (phase === 'infall' ? 6 : 3.5));

      const drag = Math.pow(0.32, dt);
      for (let k = ps.length - 1; k >= 0; k--) {
        const p = ps[k];
        if (p.out) {
          p.vx *= drag; p.vy *= drag;
          p.life -= dt;
          if (p.x < -20 || p.y < -20 || p.x > W + 20 || p.y > H + 20) { ps.splice(k, 1); continue; }
          if (p.life <= 0) {
            // Debris that has slowed down gets recaptured: it swings sideways and joins the next spiral
            const dx = cx - p.x, dy = cy - p.y, d = Math.hypot(dx, dy) || 1;
            const t = rand(90, 170) * scale;
            p.vx += (-dy / d) * t; p.vy += (dx / d) * t;
            p.out = false; p.age = 0.35;
          }
        } else {
          const dx = cx - p.x, dy = cy - p.y, d2 = dx * dx + dy * dy, d = Math.sqrt(d2) || 1;
          const nx = dx / d, ny = dy / d;
          const g = (140 + 9e6 / (d2 + 9000)) * scale;          // pull gets much stronger near the core
          p.vx += nx * g * dt; p.vy += ny * g * dt;
          // Bleed off sideways speed so orbits tighten into a spiral (much faster near the core)
          const swirlLoss = Math.max(0, 1 - (0.3 + 3.2 * clamp01(1 - d / (260 * scale))) * dt);
          const vr = p.vx * nx + p.vy * ny;
          const tx = p.vx - vr * nx, ty = p.vy - vr * ny;
          p.vx = vr * nx + tx * swirlLoss; p.vy = vr * ny + ty * swirlLoss;
          const sp = Math.hypot(p.vx, p.vy), cap = 1400 * scale;
          if (sp > cap) { p.vx *= cap / sp; p.vy *= cap / sp; }
          if (d < R + cell * 0.6) { ps.splice(k, 1); mass++; continue; }  // swallowed
        }
        // Cursor gently pushes pixels away
        if (inside) {
          const ex = p.x - px, ey = p.y - py, ed = Math.hypot(ex, ey);
          if (ed < 110 && ed > 0.1) { const f = (1 - ed / 110) * 1500 * dt; p.vx += (ex / ed) * f; p.vy += (ey / ed) * f; }
        }
        p.lx = p.x; p.ly = p.y;
        if (FREE) { (p.hist ??= []).push(p.x, p.y); if (p.hist.length > TRAIL_LEN * 2) p.hist.splice(0, 2); }
        p.x += p.vx * dt; p.y += p.vy * dt; p.age += dt;
      }
    }

    // Colour a pixel by where it is: cool outside, warming as it nears the core
    function colourOf(p: P) {
      if (p.out) return p.col;
      const d = Math.hypot(p.x - cx, p.y - cy), depth = DEPTH * scale;
      if (d < depth && (p.col * 7 + Math.floor(depth - d)) % 9 > 1) return d < R + cell * 4 ? DEEPEST : LEAVES[p.col % LEAVES.length];
      return p.col;
    }
    const brightness = (p: P) => (p.out ? 0.35 + 0.65 * (p.life / p.max) : 0.3 + 0.7 * clamp01(p.age / 0.7));

    // ---------- free (non-grid) styles ----------
    function petalPath(x: number, y: number, len: number, a: number) {
      // Teardrop petal pointing along angle a
      const c = Math.cos(a), s = Math.sin(a), w = len * 0.42;
      const tx = x + c * len, ty = y + s * len;
      ctx!.moveTo(x - c * len * 0.25, y - s * len * 0.25);
      ctx!.quadraticCurveTo(x - s * w + c * len * 0.4, y + c * w + s * len * 0.4, tx, ty);
      ctx!.quadraticCurveTo(x + s * w + c * len * 0.4, y - c * w + s * len * 0.4, x - c * len * 0.25, y - s * len * 0.25);
    }
    function renderFree() {
      const g = ctx!;
      g.clearRect(0, 0, W, H);
      if (SHAPE === 'watercolor') g.globalCompositeOperation = 'multiply';
      g.lineCap = 'round'; g.lineJoin = 'round';

      for (const p of ps) {
        const colr = PALETTE[colourOf(p)].c, b = brightness(p);
        if (p.sz === undefined) { p.sz = rand(0.7, 1.35); p.spin = rand(-4, 4); }
        const h = p.hist ?? [], n = h.length / 2, a = Math.atan2(p.vy, p.vx);
        g.fillStyle = colr; g.strokeStyle = colr;
        if (SHAPE === 'threads') {
          // A fine line through the recent positions, fading toward the tail
          for (let k = 1; k < n; k++) {
            g.globalAlpha = 0.85 * b * (k / n); g.lineWidth = 2 * p.sz! * (0.4 + 0.6 * k / n);
            g.beginPath(); g.moveTo(h[2 * k - 2], h[2 * k - 1]); g.lineTo(h[2 * k], h[2 * k + 1]); g.stroke();
          }
        } else if (SHAPE === 'glow') {
          for (let k = 0; k < n; k += 2) { g.globalAlpha = 0.1 * b * (k / n); g.beginPath(); g.arc(h[2 * k], h[2 * k + 1], 2.4 * p.sz!, 0, Math.PI * 2); g.fill(); }
          g.globalAlpha = 0.16 * b; g.beginPath(); g.arc(p.x, p.y, 6.5 * p.sz!, 0, Math.PI * 2); g.fill();
          g.globalAlpha = 0.95 * b; g.beginPath(); g.arc(p.x, p.y, 2.2 * p.sz!, 0, Math.PI * 2); g.fill();
        } else if (SHAPE === 'blossom') {
          g.globalAlpha = b; g.beginPath();
          petalPath(p.x, p.y, (10 * p.sz! + 3) * Math.max(scale, 0.7), a + Math.sin(simT * p.spin! + p.sz! * 9) * 1.3); g.fill();
        } else if (SHAPE === 'watercolor') {
          // Soft overlapping dabs that build up colour where paths cross
          for (let k = 0; k < n; k += 2) {
            g.globalAlpha = 0.34 * b * (0.3 + 0.7 * k / n); g.beginPath();
            g.ellipse(h[2 * k], h[2 * k + 1], 10 * p.sz!, 5 * p.sz!, a, 0, Math.PI * 2); g.fill();
          }
        }
      }
      g.globalCompositeOperation = 'source-over'; g.globalAlpha = 1;

      // Shockwave: one soft expanding ring
      for (let k = waves.length - 1; k >= 0; k--) {
        const w = waves[k], age = simT - w.t0, life = 0.9 + w.pow * 0.5;
        if (age > life) { waves.splice(k, 1); continue; }
        const rad = age * 900 * scale * (0.7 + w.pow * 0.4), f = 1 - age / life;
        g.globalAlpha = 0.55 * f; g.strokeStyle = PALETTE[WARM[0]].c; g.lineWidth = 2 + 6 * f;
        g.beginPath(); g.arc(cx, cy, rad, 0, Math.PI * 2); g.stroke();
      }
      // Core with a soft warm halo
      if (R > 1) {
        const halo = g.createRadialGradient(cx, cy, R * 0.8, cx, cy, R * 2.4);
        halo.addColorStop(0, `rgba(${HALO},0.45)`); halo.addColorStop(1, `rgba(${HALO},0)`);
        g.globalAlpha = 1; g.fillStyle = halo; g.beginPath(); g.arc(cx, cy, R * 2.4, 0, Math.PI * 2); g.fill();
        g.fillStyle = CORE; g.beginPath(); g.arc(cx, cy, R, 0, Math.PI * 2); g.fill();
      }
      // Fade the bottom out so it melts into the next section
      const fadeTop = H * 0.78;
      const grad = g.createLinearGradient(0, fadeTop, 0, H);
      grad.addColorStop(0, 'rgba(0,0,0,0)'); grad.addColorStop(1, 'rgba(0,0,0,1)');
      g.globalAlpha = 1; g.globalCompositeOperation = 'destination-out';
      g.fillStyle = grad; g.fillRect(0, fadeTop, W, H - fadeTop);
      g.globalCompositeOperation = 'source-over';
    }

    function render() {
      if (FREE) { renderFree(); return; }
      // Streaks: previous frame's intensity fades, then each pixel stamps its cell in its own colour
      const fade = Math.pow(TRAIL_FADE, SPEED / 60);   // streaks stay the same length on screen at any speed
      for (let i = 0; i < heat.length; i++) heat[i] *= fade;
      for (const p of ps) {
        const c = Math.floor(p.x / cell), r = Math.floor(p.y / cell);
        if (c < 0 || r < 0 || c >= cols || r >= rows) continue;
        // Debris fades as it cools; incoming pixels fade in (no popping at the edges)
        const v = p.out ? 0.35 + 0.65 * (p.life / p.max) : 0.3 + 0.7 * clamp01(p.age / 0.7);
        const i = r * cols + c;
        let pc = p.col;
        if (!p.out) {
          // Close to the core pixels heat up into warm sun colours (a few keep their colour for sparkle)
          const d = Math.hypot(p.x - cx, p.y - cy);
          const depth = DEPTH * scale;
          if (d < depth && (p.col * 7 + Math.floor(depth - d)) % 9 > 1) {
            pc = LEAVES[p.col % LEAVES.length];
            if (d < R + cell * 4) pc = DEEPEST;   // last stretch before the core
          }
        }
        if (v >= heat[i]) { heat[i] = v; col[i] = pc; ang[i] = Math.atan2(p.vy, p.vx); }
      }
      // Shockwave rings: broken, sparkly, in the warm colours
      for (let k = waves.length - 1; k >= 0; k--) {
        const w = waves[k], age = simT - w.t0, life = 0.9 + w.pow * 0.5;
        if (age > life) { waves.splice(k, 1); continue; }
        const rad = age * 900 * scale * (0.7 + w.pow * 0.4), width = cell * 2.2, fall = 1 - age / life;
        const c0 = Math.max(0, Math.floor((cx - rad - width) / cell)), c1 = Math.min(cols - 1, Math.ceil((cx + rad + width) / cell));
        const r0 = Math.max(0, Math.floor((cy - rad - width) / cell)), r1 = Math.min(rows - 1, Math.ceil((cy + rad + width) / cell));
        const fr = Math.floor(simT * 30);
        for (let r = r0; r <= r1; r++) for (let c = c0; c <= c1; c++) {
          const d = Math.hypot((c + 0.5) * cell - cx, (r + 0.5) * cell - cy);
          const g = Math.min(1, Math.exp(-(((d - rad) / width) ** 2)) * fall * w.pow);
          if (g < 0.15 || hash3(c, r, fr) > 0.7) continue;
          const i = r * cols + c;
          if (g > heat[i]) { heat[i] = g; col[i] = WARM[Math.floor(hash3(c, r, 3) * WARM.length)]; ang[i] = Math.atan2((r + 0.5) * cell - cy, (c + 0.5) * cell - cx); }
        }
      }

      const tick = Math.floor(simT * 8);
      const charge = charging ? Math.min((performance.now() / 1000 - chargeStart) / 1.5, 1) : 0;
      const ringW = cell * (1.6 + charge * 1.5);
      const CORE_KEY = PALETTE.length * ALPHAS.length;
      for (let r = 0; r < rows; r++) {
        const yf = (r + 0.5) / rows;
        const tail = clamp01((0.98 - yf) / 0.16);   // bottom stretch breaks up: no hard edge
        for (let c = 0; c < cols; c++) {
          const i = r * cols + c;
          let k = -1;
          if (hash3(c, r, 7) < tail) {
            const v = heat[i];
            if (v > 0.66) k = col[i] * 3;
            else if (v > 0.36) k = col[i] * 3 + 1;
            else if (v > 0.14) k = col[i] * 3 + 2;
            // The core: solid dark disc with a flickering warm rim
            if (R > 1) {
              const d = Math.hypot((c + 0.5) * cell - cx, (r + 0.5) * cell - cy);
              if (d < R) k = CORE_KEY;
              else if (d < R + ringW && hash3(c, r, tick) < 0.7) k = WARM[Math.floor(hash3(c, r, tick + 1) * WARM.length)] * 3;
            }
          }
          key[i] = k;
        }
      }

      ctx!.clearRect(0, 0, W, H);
      const g = cell, half = g / 2;
      for (let kk = 0; kk <= CORE_KEY; kk++) {
        const isCore = kk === CORE_KEY;
        if (isCore) { ctx!.fillStyle = CORE; ctx!.globalAlpha = 1; }
        else { ctx!.fillStyle = PALETTE[Math.floor(kk / 3)].c; ctx!.globalAlpha = ALPHAS[kk % 3]; }
        if (SHAPE === 'square' || SHAPE === 'tight') {
          const sz = SHAPE === 'tight' ? g : g - 1;
          for (let i = 0; i < key.length; i++) if (key[i] === kk) ctx!.fillRect((i % cols) * g, Math.floor(i / cols) * g, sz, sz);
          continue;
        }
        ctx!.beginPath();
        for (let i = 0; i < key.length; i++) {
          if (key[i] !== kk) continue;
          const c = i % cols, r = (i / cols) | 0, x = c * g, y = r * g, mx = x + half, my = y + half;
          if (SHAPE === 'round') {
            ctx!.roundRect(x + 0.5, y + 0.5, g - 1.5, g - 1.5, g * 0.3);
          } else if (SHAPE === 'dot' || (isCore && SHAPE === 'petal')) {
            ctx!.moveTo(mx + half * 0.82, my); ctx!.arc(mx, my, half * 0.82, 0, Math.PI * 2);
          } else if (SHAPE === 'petal') {
            const a = ang[i];
            ctx!.moveTo(mx + Math.cos(a) * g * 0.72, my + Math.sin(a) * g * 0.72);
            ctx!.ellipse(mx, my, g * 0.72, g * 0.3, a, 0, Math.PI * 2);
          } else if (SHAPE === 'brush') {
            // Painterly dab: jittered, rotated, overlapping blob (stable per cell so it doesn't shimmer)
            const h1 = hash3(c, r, 11), h2 = hash3(c, r, 12), h3 = hash3(c, r, 13);
            const rx = g * (0.62 + 0.38 * h1), ry = g * (0.38 + 0.24 * h2), rot = h3 * Math.PI;
            const ox = mx + (h2 - 0.5) * g * 0.5, oy = my + (h1 - 0.5) * g * 0.5;
            ctx!.moveTo(ox + Math.cos(rot) * rx, oy + Math.sin(rot) * rx);
            ctx!.ellipse(ox, oy, rx, ry, rot, 0, Math.PI * 2);
          }
        }
        ctx!.fill();
      }
      ctx!.globalAlpha = 1;
    }

    // ---------- loop ----------
    let last = 0, running = false, raf = 0;
    function frame(nowMs: number) {
      const now = nowMs / 1000;
      const dt = Math.min(now - last, 1 / 30);
      last = now;
      step(dt * SPEED);
      render();
      if (running) raf = requestAnimationFrame(frame);
    }
    function start() { if (running || reduced) return; running = true; last = performance.now() / 1000; raf = requestAnimationFrame(frame); }
    function stop() { running = false; cancelAnimationFrame(raf); }

    function stillFrame() {
      // Fast-forward to mid-spiral and draw once
      ps.length = 0; mass = 0; phase = 'infall'; phaseT = 0; R = 0;
      for (let k = 0; k < 300; k++) step(1 / 60);
      for (let k = 0; k < 20; k++) render();
    }

    size();
    const still = params.get('still');
    if (still) {
      // Preview mode: deterministic frame for comparing styles
      let seedN = 12345;
      Math.random = () => { seedN = (seedN + 0x6d2b79f5) | 0; let t = Math.imul(seedN ^ (seedN >>> 15), 1 | seedN); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
      ps.length = 0; mass = 0; phase = 'infall'; phaseT = 0; R = 0;
      const steps = still === 'explode' ? 0 : Number(still) || 420;
      if (still === 'explode') { while (phase === 'infall') { step(1 / 60); render(); } for (let k = 0; k < 22; k++) { step(1 / 60); render(); } }
      else for (let k = 0; k < steps; k++) { step(1 / 60); render(); }
      return;
    }
    if (reduced) stillFrame();
    new ResizeObserver(() => { size(); if (reduced) stillFrame(); }).observe(root);
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0 }).observe(root);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }

  document.querySelectorAll<HTMLElement>('.hero-anim').forEach(init);
</script>
