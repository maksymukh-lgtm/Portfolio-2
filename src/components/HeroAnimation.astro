---
/*
  "Chaos → order": UI fragments drift loosely, then snap into a structured
  dashboard layout, hold, and scatter again.

  Every piece is placed at its final ("ordered") position in % of the stage.
  JS only toggles a transform that throws it somewhere random in the
  container, so the ordered state is plain CSS and needs no JS at all
  (that's also the reduced-motion / no-JS fallback).

  Layout coordinates: [x, y, w, h] in % of a 2.6:1 stage.
*/
type Kind = 'card' | 'line' | 'accent' | 'soft' | 'ink' | 'dot' | 'dot-accent' | 'bar' | 'bar-accent';
type Piece = { r: [number, number, number, number]; k: Kind; group: 0 | 1 };

const pieces: Piece[] = [];
const add = (k: Kind, x: number, y: number, w: number, h: number, group: 0 | 1 = 1) =>
  pieces.push({ k, r: [x, y, w, h], group });

// Cards (group 0 lands first)
add('card', 0, 0, 14, 100, 0);   // sidebar
add('card', 16, 0, 84, 11, 0);   // top bar
add('card', 16, 15, 26, 27, 0);  // stat 1
add('card', 45, 15, 26, 27, 0);  // stat 2
add('card', 74, 15, 26, 27, 0);  // stat 3
add('card', 16, 46, 55, 54, 0);  // chart
add('card', 74, 46, 26, 54, 0);  // list

// Sidebar: logo + nav
add('dot-accent', 3, 4.5, 3, 7.8);
for (let i = 0; i < 5; i++) add(i === 0 ? 'accent' : 'line', 3, 20 + i * 9, i === 0 ? 8 : 7 - (i % 2), 3);

// Top bar: search, avatar, button
add('line', 18.5, 3.8, 22, 3.6);
add('dot', 85.2, 2.6, 2.2, 5.8);
add('accent', 89, 3, 9, 5);

// Stat cards: label, number, tag
for (let c = 0; c < 3; c++) {
  const x = 18.5 + c * 29;
  add('line', x, 20, 10, 3);
  add('ink', x, 27, 13 - c * 2, 7);
  add(c === 1 ? 'accent' : 'soft', x, 36.5, 6, 3);
}

// Chart: title + bars
add('line', 18.5, 51, 14, 3);
const bars = [18, 26, 21, 34, 29, 40, 31];
bars.forEach((h, i) => add(i === 5 ? 'bar-accent' : 'bar', 19 + i * 7.2, 95 - h, 4.2, h));

// List: dots + rows
for (let i = 0; i < 5; i++) {
  add(i === 1 ? 'dot-accent' : 'dot', 76.5, 52 + i * 9, 1.5, 3.9);
  add('line', 79.5, 52.7 + i * 9, 17 - (i % 3) * 3, 2.5);
}
---

<div class="hero-anim" role="img" aria-label="Scattered interface fragments snapping into an organised layout">
  <div class="stage">
    {pieces.map((p, i) => (
      <span
        class={`piece ${p.k}`}
        data-group={p.group}
        style={`left:${p.r[0]}%;top:${p.r[1]}%;width:${p.r[2]}%;height:${p.r[3]}%;--i:${i}`}
      ><span class="float"></span></span>
    ))}
  </div>
</div>

<style>
  .hero-anim {
    position: relative;
    overflow: hidden;
    background: var(--color-hero);
    height: clamp(220px, 30vw, 430px);
    container-type: size;
  }
  .stage {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: min(88cqw, 197.6cqh); /* 76% of height × 2.6 */
    aspect-ratio: 2.6;
  }

  .piece {
    position: absolute;
    display: block;
    transform: none;
    transition: transform 1.5s cubic-bezier(0.7, 0, 0.15, 1) var(--delay, 0s);
    will-change: transform;
  }
  .float {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: inherit;
    border: inherit;
  }
  /* Gentle drift while scattered */
  .is-chaos .float {
    animation: drift var(--drift-dur, 6s) ease-in-out var(--drift-delay, 0s) infinite alternate;
  }
  @keyframes drift {
    from { translate: 0 0; rotate: 0deg; }
    to   { translate: var(--dx, 8px) var(--dy, -10px); rotate: var(--dr, 4deg); }
  }

  .card {
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 6px;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04);
  }
  .card .float { border: 0; }
  .line   { background: #d6d6d6; border-radius: 999px; }
  .ink    { background: var(--color-text); border-radius: 3px; }
  .accent { background: var(--color-accent); border-radius: 999px; }
  .soft   { background: #c9bfff; border-radius: 999px; }
  .dot, .dot-accent { border-radius: 50%; }
  .dot        { background: #cfcfcf; }
  .dot-accent { background: var(--color-accent); }
  .bar        { background: #c9bfff; border-radius: 3px 3px 0 0; }
  .bar-accent { background: var(--color-accent); border-radius: 3px 3px 0 0; }

  @media (prefers-reduced-motion: reduce) {
    .piece { transition: none; }
    .is-chaos .float { animation: none; }
  }
</style>

<script>
  const ORDER_HOLD = 4200;  // ms the organised layout stays
  const CHAOS_HOLD = 3200;  // ms the fragments drift
  const rand = (a: number, b: number) => a + Math.random() * (b - a);

  function init(root: HTMLElement) {
    const stage = root.querySelector<HTMLElement>('.stage')!;
    const pieces = [...root.querySelectorAll<HTMLElement>('.piece')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) return; // stays in the ordered layout

    let chaos = false;
    let timer: number | undefined;
    let visible = false;

    function scatter() {
      const box = root.getBoundingClientRect();
      const st = stage.getBoundingClientRect();
      const sx = st.left - box.left;
      const sy = st.top - box.top;
      pieces.forEach((el) => {
        const isCard = el.classList.contains('card');
        // Untransformed position of the piece inside the container
        const cx = sx + el.offsetLeft + el.offsetWidth / 2;
        const cy = sy + el.offsetTop + el.offsetHeight / 2;
        const tx = rand(0.06, 0.94) * box.width - cx;
        const ty = rand(0.12, 0.88) * box.height - cy;
        const rot = rand(-38, 38);
        const scale = isCard ? rand(0.32, 0.55) : rand(0.85, 1.25);
        el.style.transform = `translate(${tx}px, ${ty}px) rotate(${rot}deg) scale(${scale})`;
        el.style.setProperty('--delay', `${rand(0, 0.35)}s`);
        el.style.setProperty('--dx', `${rand(-14, 14)}px`);
        el.style.setProperty('--dy', `${rand(-14, 14)}px`);
        el.style.setProperty('--dr', `${rand(-8, 8)}deg`);
        el.style.setProperty('--drift-dur', `${rand(4, 8)}s`);
        el.style.setProperty('--drift-delay', `${rand(-4, 0)}s`);
      });
      root.classList.add('is-chaos');
      chaos = true;
    }

    function order() {
      pieces.forEach((el) => {
        const group = Number(el.dataset.group);
        // Cards land first, then their contents
        el.style.setProperty('--delay', `${group === 0 ? rand(0, 0.2) : rand(0.35, 0.9)}s`);
        el.style.transform = 'none';
      });
      root.classList.remove('is-chaos');
      chaos = false;
    }

    function tick() {
      if (!visible) return;
      chaos ? order() : scatter();
      timer = window.setTimeout(tick, chaos ? CHAOS_HOLD : ORDER_HOLD + 1500);
    }

    // Start scattered (no transition) so the first thing people see is it coming together
    pieces.forEach((el) => (el.style.transition = 'none'));
    scatter();
    root.offsetWidth; // flush styles
    pieces.forEach((el) => (el.style.transition = ''));

    // Only animate while on screen
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      window.clearTimeout(timer);
      if (visible) timer = window.setTimeout(tick, chaos ? 900 : ORDER_HOLD);
    }, { threshold: 0.2 }).observe(root);

    // Re-scatter to fit the new size if the window changes while scattered
    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => chaos && scatter(), 200);
    });
  }

  document.querySelectorAll<HTMLElement>('.hero-anim').forEach(init);
</script>
