---
/*
  Hero pixel field.
  A grid of small square cells. Each cell has a value 0..1 that picks a colour
  band (light lavender → purple → ink). The value comes from:
    1. an ambient, slowly drifting noise field that dissolves raggedly downward
    2. "heat" left by the cursor (fades over time)
    3. shockwaves released by click-and-hold
  Pure canvas 2D, no libraries. Pauses off-screen; static frame for reduced motion.
*/
---

<div class="hero-anim" aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  .hero-anim {
    position: relative;
    height: clamp(220px, 30vw, 430px);
    background: var(--color-bg);
    border-top: 1px solid var(--color-line);
    cursor: crosshair;
    touch-action: pan-y;
    overflow: hidden;
  }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
</style>

<script>
  // Colour bands, cool → hot. Swap these to re-theme the whole field.
  const BANDS = ['#e7e2ff', '#c9bfff', '#9b86ff', '#6f52ff', '#3b23c4', '#15103f'];
  const GRID = '#f4f4f6';        // empty cells: faint graph paper
  const INTRO = 1.6;             // seconds for pixels to flicker in

  // ---------- small value-noise implementation ----------
  const hash3 = (x: number, y: number, z: number) => {
    let h = (x * 374761393 + y * 668265263 + z * 2147483647) | 0;
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
  };
  const fade = (t: number) => t * t * (3 - 2 * t);
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  function noise3(x: number, y: number, z: number) {
    const xi = Math.floor(x), yi = Math.floor(y), zi = Math.floor(z);
    const xf = fade(x - xi), yf = fade(y - yi), zf = fade(z - zi);
    const c = (dx: number, dy: number, dz: number) => hash3(xi + dx, yi + dy, zi + dz);
    return lerp(
      lerp(lerp(c(0, 0, 0), c(1, 0, 0), xf), lerp(c(0, 1, 0), c(1, 1, 0), xf), yf),
      lerp(lerp(c(0, 0, 1), c(1, 0, 1), xf), lerp(c(0, 1, 1), c(1, 1, 1), xf), yf),
      zf,
    );
  }
  const fbm = (x: number, y: number, z: number) =>
    noise3(x, y, z) * 0.55 + noise3(x * 2.1, y * 2.1, z * 1.3) * 0.3 + noise3(x * 4.3, y * 4.3, z * 1.7) * 0.15;
  const cellHash = (c: number, r: number) => hash3(c, r, 7);
  const clamp01 = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);

  function init(root: HTMLElement) {
    const cv = root.querySelector('canvas')!;
    const ctx = cv.getContext('2d');
    if (!ctx) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const touch = !matchMedia('(hover: hover) and (pointer: fine)').matches;

    let W = 0, H = 0, cell = 10, cols = 0, rows = 0;
    let heat = new Float32Array(0);
    let band = new Int8Array(0);
    const seed = Math.random() * 100;

    function size() {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      W = root.clientWidth; H = root.clientHeight;
      cell = W < 600 ? 8 : 10;
      cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.ceil(W / cell); rows = Math.ceil(H / cell);
      heat = new Float32Array(cols * rows);
      band = new Int8Array(cols * rows);
    }

    // ---------- interaction ----------
    let px = -1, py = -1, lastX = -1, lastY = -1, inside = false;
    let charging = false, chargeStart = 0;
    const waves: { x: number; y: number; t0: number; pow: number }[] = [];

    function deposit(x: number, y: number, amt: number, radius: number) {
      const cc = x / cell, cr = y / cell, rad = Math.ceil(radius * 1.8);
      const inv = 1 / (2 * radius * radius * 0.35);
      for (let dr = -rad; dr <= rad; dr++) for (let dc = -rad; dc <= rad; dc++) {
        const c = Math.floor(cc + dc), r = Math.floor(cr + dr);
        if (c < 0 || r < 0 || c >= cols || r >= rows) continue;
        const dx = c + 0.5 - cc, dy = r + 0.5 - cr;
        const w = Math.exp(-(dx * dx + dy * dy) * inv);
        if (w < 0.03) continue;
        const i = r * cols + c;
        heat[i] = Math.min(1, heat[i] + amt * w);
      }
    }
    // Stamp along the path so fast flicks stay continuous
    function trail(x: number, y: number, radius: number) {
      if (lastX < 0) { lastX = x; lastY = y; }
      const dx = x - lastX, dy = y - lastY;
      const steps = Math.max(1, Math.min(40, Math.round(Math.hypot(dx, dy) / (cell * 0.8))));
      for (let s = 1; s <= steps; s++) deposit(lastX + (dx * s) / steps, lastY + (dy * s) / steps, 0.14, radius);
      lastX = x; lastY = y;
    }

    const local = (e: PointerEvent) => {
      const r = cv.getBoundingClientRect();
      return [e.clientX - r.left, e.clientY - r.top];
    };
    root.addEventListener('pointermove', (e) => { [px, py] = local(e); inside = true; });
    root.addEventListener('pointerleave', () => { inside = false; lastX = -1; charging = false; });
    root.addEventListener('pointerdown', (e) => {
      [px, py] = local(e);
      if (touch) { waves.push({ x: px, y: py, t0: performance.now() / 1000, pow: 0.7 }); return; }
      charging = true; chargeStart = performance.now() / 1000;
    });
    addEventListener('pointerup', () => {
      if (!charging) return;
      charging = false;
      const charge = Math.min((performance.now() / 1000 - chargeStart) / 2, 1); // 2s to full
      waves.push({ x: px, y: py, t0: performance.now() / 1000, pow: 0.45 + charge * 0.9 });
    });

    // ---------- render ----------
    let t0 = performance.now() / 1000, last = t0, running = false, raf = 0;

    function frame(nowMs: number) {
      const now = nowMs / 1000;
      const dt = Math.min(now - last, 0.05);
      last = now;
      const t = now - t0;
      const intro = reduced ? 99 : t;
      const tick = Math.floor(t * 7); // accent flicker ~7fps

      // Cursor heat
      if (inside && !reduced) {
        const charge = charging ? Math.min((now - chargeStart) / 2, 1) : 0;
        trail(px, py, 2.6 + charge * 4);
        if (charging) deposit(px, py, 0.05 + charge * 0.08, 2 + charge * 5);
      }
      // Shockwaves: an expanding ring of heat
      for (let k = waves.length - 1; k >= 0; k--) {
        const w = waves[k], age = now - w.t0, life = 1.1 + w.pow;
        if (age > life) { waves.splice(k, 1); continue; }
        const R = age * (420 + w.pow * 380), width = 26 + w.pow * 30, falloff = 1 - age / life;
        const c0 = Math.max(0, Math.floor((w.x - R - width) / cell)), c1 = Math.min(cols - 1, Math.ceil((w.x + R + width) / cell));
        const r0 = Math.max(0, Math.floor((w.y - R - width) / cell)), r1 = Math.min(rows - 1, Math.ceil((w.y + R + width) / cell));
        for (let r = r0; r <= r1; r++) for (let c = c0; c <= c1; c++) {
          const d = Math.hypot((c + 0.5) * cell - w.x, (r + 0.5) * cell - w.y);
          const g = Math.exp(-(((d - R) / width) ** 2));
          if (g < 0.05) continue;
          const i = r * cols + c, v = w.pow * g * falloff;
          if (v > heat[i]) heat[i] = Math.min(1, v);
        }
      }

      // Decay heat (frame-rate independent)
      const decay = Math.pow(0.18, dt);
      for (let i = 0; i < heat.length; i++) heat[i] *= decay;

      // Compute band per cell
      const aspect = W / H, z = seed + t * 0.12;
      for (let r = 0; r < rows; r++) {
        const yf = (r + 0.5) / rows;
        for (let c = 0; c < cols; c++) {
          const i = r * cols + c, xf = (c + 0.5) / cols;
          const hc = cellHash(c, r);

          // Ambient field, dissolving downward along a wavy, ragged edge
          let amb = 0;
          const cut = 0.7 + 0.14 * Math.sin(c * 0.07 + t * 0.18) + 0.1 * Math.sin(c * 0.23 - t * 0.11);
          const edge = clamp01((cut - yf) / 0.28);
          if (edge > 0 && hc < edge * 1.15) {
            const n = fbm(xf * aspect * 2.2 + t * 0.03, yf * 2.2, z);
            amb = clamp01((n - 0.31) / 0.38);
            // Coarse patches survive further down; scattered singles fade out
            amb *= 0.55 + 0.45 * edge;
          }
          if (intro < INTRO && hc * INTRO > intro) amb = 0; // on-load flicker-in

          const v = Math.max(amb, heat[i]);
          let b = -1;
          if (v > 0.16) {
            b = Math.min(BANDS.length - 1, Math.floor(((v - 0.16) / 0.84) * BANDS.length));
            if (b === 0 && hc > 0.55) b = -1;                 // lightest band is speckled
            else if (hash3(c, r, tick) < 0.04) b = Math.max(0, Math.min(BANDS.length - 1, b + (hc > 0.5 ? 1 : -1))); // flicker
          }
          band[i] = b;
        }
      }

      // Draw: faint grid first, then each colour band in one pass
      ctx!.clearRect(0, 0, W, H);
      const s = cell - 1;
      ctx!.fillStyle = GRID;
      for (let i = 0; i < band.length; i++) if (band[i] < 0) ctx!.fillRect((i % cols) * cell, Math.floor(i / cols) * cell, s, s);
      for (let b = 0; b < BANDS.length; b++) {
        ctx!.fillStyle = BANDS[b];
        for (let i = 0; i < band.length; i++) if (band[i] === b) ctx!.fillRect((i % cols) * cell, Math.floor(i / cols) * cell, s, s);
      }

      if (running && !reduced) raf = requestAnimationFrame(frame);
    }

    function start() { if (running || reduced) return; running = true; last = performance.now() / 1000; raf = requestAnimationFrame(frame); }
    function stop() { running = false; cancelAnimationFrame(raf); }

    size();
    if (reduced) frame(performance.now()); // one static frame
    new ResizeObserver(() => { size(); if (!running) frame(performance.now()); }).observe(root);
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0 }).observe(root);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }

  document.querySelectorAll<HTMLElement>('.hero-anim').forEach(init);
</script>
