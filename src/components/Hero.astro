---
import HeroAnimation from './HeroAnimation.astro';
---
<section class="hero">
  <div class="container intro">
    <h1>Hello, I’m Hanna</h1>
    <p class="bio">
      I’m a designer obsessed with the big picture: concepts, systems and the logic
      that holds them together. I don’t just make things look good. I make them make sense.
    </p>
  </div>
  <HeroAnimation />
</section>

<style>
  .intro {
    --header-gap: 3.5rem; /* 56px between header and hero text */
    display: grid;
    grid-template-columns: 1fr minmax(0, 30rem);
    align-items: start;
    gap: 3rem;
  }
  h1 {
    font-size: var(--fs-display);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
    padding-block: var(--header-gap) 3.5rem;
  }
  .bio {
    font-size: 1.25rem; /* 20px */
    line-height: 1.5;
    padding: 0 0 3.5rem calc(3rem + var(--bio-shift, 0px));
    border-left: 1px solid var(--color-line);
    /* Extend the divider up to the top of the page like the mockup */
    margin-top: -6rem;
    padding-top: calc(6rem + var(--header-gap));
  }
  @media (max-width: 800px) {
    .intro { grid-template-columns: 1fr; gap: 0; }
    h1 { padding-bottom: 1.5rem; }
    .bio { border-left: 0; padding: 0 0 2.5rem; margin-top: 0; --bio-shift: 0px !important; }
  }
</style>

<script>
  // Shift the bio text so its longest line ends exactly at the right edge of the
  // column (lined up with the last letter of "Contacts"). The divider stays put;
  // the extra left padding equals the empty space after the longest line, so the
  // line breaks don't change.
  function alignBio() {
    const bio = document.querySelector<HTMLElement>('.bio');
    if (!bio) return;
    bio.style.removeProperty('--bio-shift');
    const range = document.createRange();
    range.selectNodeContents(bio);
    const right = Math.max(...[...range.getClientRects()].map((r) => r.right));
    const boxRight = bio.getBoundingClientRect().right - parseFloat(getComputedStyle(bio).paddingRight);
    const slack = Math.floor(boxRight - right - 1);
    if (slack > 0) bio.style.setProperty('--bio-shift', `${slack}px`);
  }
  document.fonts?.ready.then(alignBio);
  alignBio();
  let t: number | undefined;
  addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(alignBio, 100); });
</script>
