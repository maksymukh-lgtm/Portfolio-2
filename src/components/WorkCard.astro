---
const { title, summary, image, alt = '', href, bg = 'var(--color-placeholder)', border = 'transparent', comingSoon = false } = Astro.props;
// A "coming soon" card renders as a plain block (not a link) with a label
const Tag = comingSoon ? 'div' : 'a';
// Loose pixels breaking off the band's edges, like the hero animation's dissolving edge
const PIX = ['#8fc3bd', '#c3ddd5', '#f8cfa6', '#fde27a', '#fcbc45', '#f98f33'];
const rnd = (n) => { const x = Math.sin(n * 127.1) * 43758.5453; return x - Math.floor(x); };
const edgePixels = Array.from({ length: 34 }, (_, i) => {
  const top = i % 2 === 0;
  return { x: rnd(i + 1) * 100, y: top ? -(1 + Math.floor(rnd(i + 7) * 3)) : (1 + Math.floor(rnd(i + 7) * 3)), top, c: PIX[Math.floor(rnd(i + 3) * PIX.length)] };
});
---
<div class:list={['wrap', { 'soon-wrap': comingSoon }]}>
{comingSoon && (
  <span class="band" aria-hidden="true">
    {edgePixels.map((p) => (
      <i class={p.top ? 't' : 'b'} style={`left:${p.x.toFixed(1)}%;--row:${p.y};background:${p.c}`}></i>
    ))}
    <span class="band-body"><span class="band-text">Coming soon</span></span>
  </span>
)}
<Tag class:list={['card', { soon: comingSoon }]} href={comingSoon ? undefined : href} style={`--card-bg:${bg};--card-border:${border}`} aria-label={comingSoon ? `${title}, case study coming soon` : undefined}>
  <div class="media">
    {image ? <img class="tonal-shadow" src={image} alt={alt} width="1260" height="1000" loading="lazy" decoding="async" /> : null}
  </div>
  <div class="text">
    <h3>{title}</h3>
    <p>{summary}</p>
  </div>
</Tag>
</div>

<style>
  /* Coloured card: a screenshot hanging from the top-left edge, title and description underneath */
  .card {
    display: grid;
    grid-template-rows: 1fr auto;
    aspect-ratio: 633 / 698;
    border-radius: 10px;
    border: 1px solid var(--card-border);
    background: var(--card-bg);
    --surface: var(--card-bg);
    overflow: hidden;
    text-decoration: none;
    transition: border-color 0.3s ease;
  }
  .media { position: relative; min-height: 0; }
  /* Flush with the card's top and left edges (square corners there), a gap on the
     right, and only the bottom-right corner rounded */
  img {
    position: absolute;
    top: 0;
    left: 0;
    width: 95.6%;
    height: auto;
    border-radius: 0 0 10px 0;
    background: #fff;
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover img { transform: translateY(-4px); }
  .card:hover { border-color: color-mix(in srgb, var(--card-border), #000 12%); }

  /* Coming soon: no hover effects, a small label above the title */
  .card { position: relative; }
  /* Coming soon: everything is faded to 45% except the label, which stays at full strength */
  .soon {
    cursor: default;
    background: color-mix(in srgb, var(--card-bg) 45%, #fff);
    border-color: color-mix(in srgb, var(--card-border) 45%, #fff);
  }
  .soon .media, .soon h3, .soon p { opacity: 0.45; }
  .soon:hover img { transform: none; }
  .soon:hover { border-color: color-mix(in srgb, var(--card-border) 45%, #fff); }
  /* The band: a light grey strap across the card, overhanging both edges, at full strength */
  .wrap { position: relative; height: 100%; container-type: inline-size; }
  .band {
    --cell: 6px;
    position: absolute;
    z-index: 3;
    left: -8px;
    right: -8px;
    top: 66%;
    translate: 0 -50%;
    height: calc(var(--cell) * 9);
    pointer-events: none;
  }
  /* The band body: a grid of square pixels (like the hero animation) with stepped corners */
  .band-body {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background:
      linear-gradient(90deg, transparent calc(var(--cell) - 1px), #f7f7f5 0) 0 0 / var(--cell) var(--cell),
      linear-gradient(180deg, transparent calc(var(--cell) - 1px), #f7f7f5 0) 0 0 / var(--cell) var(--cell),
      #e2e2de;
    clip-path: polygon(0 var(--cell), var(--cell) var(--cell), var(--cell) 0, calc(100% - var(--cell)) 0, calc(100% - var(--cell)) var(--cell), 100% var(--cell),
                       100% calc(100% - var(--cell)), calc(100% - var(--cell)) calc(100% - var(--cell)), calc(100% - var(--cell)) 100%, var(--cell) 100%, var(--cell) calc(100% - var(--cell)), 0 calc(100% - var(--cell)));
  }
  /* Loose pixels breaking off the top and bottom edges */
  .band i {
    position: absolute;
    width: calc(var(--cell) - 1px);
    height: calc(var(--cell) - 1px);
  }
  .band i.t { bottom: calc(100% + (var(--row) * -1 - 1) * var(--cell)); }
  .band i.b { top: calc(100% + (var(--row) - 1) * var(--cell)); }
  .band-text {
    position: relative;
    padding: 0 0.9em;
    color: #3f3f3a;
    font-family: 'Geist Mono', ui-monospace, monospace;
    font-size: clamp(0.8125rem, 0.72rem + 0.3vw, 1rem);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    line-height: calc(var(--cell) * 4);
  }

  /* Phones: the card grows taller, so pin the band to the bottom of the screenshot */
  @media (max-width: 700px) {
    .band { top: calc(86cqw - 34px); }
  }

  .text { padding: 1.5rem 1.625rem 1.75rem; }
  h3 { font-size: clamp(1.5rem, 1rem + 1.1vw, 2.125rem); line-height: 1.2; margin-bottom: 1rem; }
  p { font-size: clamp(1.0625rem, 0.85rem + 0.5vw, 1.375rem); line-height: 1.5; color: var(--color-text); max-width: 36rem; }

  /* Phones: let the card grow instead of squeezing the screenshot */
  @media (max-width: 700px) {
    .card { aspect-ratio: auto; grid-template-rows: auto auto; }
    .media { aspect-ratio: 605 / 520; }
    .text { padding: 1.25rem; }
  }
  @media (prefers-reduced-motion: reduce) { img { transition: none; } .card:hover img { transform: none; } }
</style>
