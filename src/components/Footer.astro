---
/*
  Footer: a thin living stripe of pixels along the top (sparse at the top, dense
  at the bottom, like grass), with soft waves of colour and density drifting
  across it like wind. Colours come from the hero animation. Below: a statement
  on the left and three link columns on the right. The stripe ruffles under the cursor.

  Links marked "placeholder" need your real URLs.
*/
import Icon from './Icon.astro';
const columns = [
  { title: 'Pages', links: [
    { label: 'Home', href: '#top' },
    { label: 'Recent work', href: '/#work' },
    { label: 'Archive', href: '/#archive' },
  ] },
  { title: 'Connect', links: [
    { label: 'LinkedIn', href: 'https://www.linkedin.com/in/hanna-maksymuk-0470a9271/', icon: 'linkedin', external: true },
    { label: 'Email', href: 'mailto:maksymuk.h@gmail.com', icon: 'mail' },
    { label: 'Resume', href: '/Hanna_Maksymuk_CV.pdf', icon: 'page', external: true },
  ] },
];
---
<footer class="site-footer" id="contacts">
  <canvas class="stripe" aria-hidden="true"></canvas>

  <div class="content">
    <p class="statement"><strong>Hanna Maksymuk</strong></p>

    <nav class="cols" aria-label="Footer">
      {columns.map((col) => (
        <div>
          <h3>{col.title}</h3>
          <ul>
            {col.links.map((l) => (
              <li>
                {l.href
                  ? <a href={l.href} {...(l.external ? { target: "_blank", rel: "noopener" } : {})}>{l.icon && <Icon name={l.icon} size="16" />}{l.label}</a>
                  : <span>{l.label}</span>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-inline: var(--line-x);
    padding: clamp(2.5rem, 1.5rem + 2vw, 3.5rem) 0 clamp(3rem, 2rem + 3vw, 5rem);
    background: var(--color-bg);
  }
  .stripe { display: block; width: 100%; height: 60px; }

  .content {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 3rem 4rem;
    align-items: start;
    padding: clamp(2.5rem, 1.5rem + 2.5vw, 4rem) var(--inset) 0;
  }
  /* Name: same size and weight as the name in the header */
  .statement {
    font-size: 1.25rem;   /* 20px */
    line-height: 1.5;
  }
  .statement strong { font-weight: 400; }
  .statement a, .cols a { text-decoration: none; display: inline-flex; align-items: center; gap: 0.35em; }
  .statement a { white-space: nowrap; }
  .statement a :global(svg) { width: 0.8em; height: 0.8em; }
  .statement a:hover, .cols a:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }

  .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; }
  h3 { font-size: 0.9375rem; font-weight: 500; margin-bottom: 1.25rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; font-size: 0.9375rem; color: #6b6b6b; }
  li { display: flex; align-items: center; height: 1.375rem; }   /* same row height with or without an icon */
  .cols a:hover { color: var(--color-text); }

  @media (max-width: 900px) {
    .content { grid-template-columns: 1fr; }
  }
  @media (max-width: 480px) {
    .cols { grid-template-columns: 1fr 1fr; }
    .stripe { height: 48px; }
  }
</style>

<script>
  // Hero palette, cool → warm. Waves of colour drift along the stripe through these.
  const PALETTE = ['#4f8f8a', '#8fc3bd', '#c3ddd5', '#f8cfa6', '#fde27a', '#fcbc45', '#f98f33', '#e46a1e'];
  const CELL = 6;          // pixel size (px)
  const FPS = 30;

  const hash = (x: number, y: number, z: number) => {
    let h = (x * 374761393 + y * 668265263 + z * 1274126177) | 0;
    h = Math.imul(h ^ (h >>> 13), 1274126177);
    return ((h ^ (h >>> 16)) >>> 0) / 4294967295;
  };

  function init(cv: HTMLCanvasElement) {
    const ctx = cv.getContext('2d');
    if (!ctx) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let W = 0, H = 0, cols = 0, rows = 0, mx = -1e4, stir = 0;

    function size() {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      W = cv.clientWidth; H = cv.clientHeight;
      cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.floor(W / CELL); rows = Math.floor(H / CELL);
    }
    const area = cv.closest('footer')!;
    area.addEventListener('pointermove', (e) => { mx = e.clientX - cv.getBoundingClientRect().left; });
    area.addEventListener('pointerleave', () => { mx = -1e4; });

    const t0 = performance.now();
    let last = 0, running = false, raf = 0;

    function draw(now: number) {
      const t = reduced ? 0 : (now - t0) / 1000;
      stir += ((mx > -1e3 ? 1 : 0) - stir) * 0.1;
      const s = CELL - 1;
      ctx!.clearRect(0, 0, W, H);
      const buckets: number[][] = PALETTE.map(() => []);
      for (let c = 0; c < cols; c++) {
        const x = c * CELL;
        // Wind: soft waves of density travelling left to right
        const wind = 0.55 + 0.3 * Math.sin(c * 0.045 - t * 0.9) + 0.15 * Math.sin(c * 0.13 + t * 0.6);
        // Cursor: pixels thicken and rise around it
        const near = stir * Math.exp(-((x - mx) ** 2) / (2 * 70 * 70));
        // Colour waves drifting slowly along the stripe
        const hue = 0.5 + 0.5 * Math.sin(c * 0.032 - t * 0.25 + Math.sin(c * 0.011 + t * 0.1) * 1.5);
        for (let r = 0; r < rows; r++) {
          const depth = (r + 1) / rows;                       // 0 at the top → 1 at the bottom
          const p = Math.pow(depth, 1.5) * (wind + near * 0.8) + near * 0.15;
          // Each pixel re-decides a few times a second, on its own phase, so it shimmers rather than flashes
          const phase = hash(c, r, 1);
          const tick = Math.floor(t * 2.2 + phase * 7);
          if (hash(c, r, tick) > p) continue;
          const k = Math.max(0, Math.min(PALETTE.length - 1, Math.round(hue * (PALETTE.length - 1) + (hash(c, r, tick + 99) - 0.5) * 2.4)));
          buckets[k].push(x, r * CELL);
        }
      }
      for (let k = 0; k < PALETTE.length; k++) {
        ctx!.fillStyle = PALETTE[k];
        const b = buckets[k];
        for (let i = 0; i < b.length; i += 2) ctx!.fillRect(b[i], b[i + 1], s, s);
      }
    }

    function frame(now: number) {
      if (now - last >= 1000 / FPS - 1) { last = now; draw(now); }
      if (running) raf = requestAnimationFrame(frame);
    }
    function start() { if (running || reduced) return; running = true; raf = requestAnimationFrame(frame); }
    function stop() { running = false; cancelAnimationFrame(raf); }

    size(); draw(performance.now());
    new ResizeObserver(() => { size(); draw(performance.now()); }).observe(cv);
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop()), { threshold: 0 }).observe(cv);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }

  document.querySelectorAll<HTMLCanvasElement>('.site-footer .stripe').forEach(init);
</script>
